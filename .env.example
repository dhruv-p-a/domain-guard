# DomainGuard Environment Configuration

# Server & Auth
PROJECT_NAME="DomainGuard"
SECRET_KEY="super-secret-key-change-in-production-domainguard-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM="HS256"

# Database Configuration (SQLite by default for dev, PostgreSQL for production)
DATABASE_URL="sqlite+aiosqlite:///./domainguard.db"
# POSTGRES_SERVER="localhost"
# POSTGRES_USER="postgres"
# POSTGRES_PASSWORD="your_secure_password"
# POSTGRES_DB="domainguard"

# GitHub OAuth & App Settings
GITHUB_CLIENT_ID="your_github_oauth_client_id"
GITHUB_CLIENT_SECRET="your_github_oauth_client_secret"
GITHUB_WEBHOOK_SECRET="your_github_webhook_secret_key"
GITHUB_APP_ID="123456"

# Redis & Celery Worker
REDIS_URL="redis://localhost:6379/0"

# Scanning Safety Limits
ALLOWED_SCAN_TIMEOUT=15
MAX_SCAN_CONCURRENCY=5
